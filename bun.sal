// Bun compatibility plugin public SA macro facade.
// Mirrors the layering of sa_plugin_deno/deno.sal:
//   1. plugin's own C-ABI (sa_bun_plugin_*) for the sync Bun.* subset,
//   2. sa_http_server_* for the Bun.serve accept/respond path,
//   3. sa_http_client_* is imported alongside for fetch-style outbound calls.
@import "bun.sai"
@import "sa_http_client.sai"
@import "sa_http_server.sai"

[MACRO] BUN_FREE_BUFFER %ptr, %len, %out_status
    %out_status = call @sa_bun_plugin_free_buffer(%ptr, %len)
[END_MACRO]

[MACRO] BUN_VERSION %out_ptr, %out_len, %out_status
    __bun_v_ptr_slot = stack_alloc 8
    __bun_v_len_slot = stack_alloc 8
    %out_status = call @sa_bun_plugin_version(&__bun_v_ptr_slot, &__bun_v_len_slot)
    %out_ptr = load __bun_v_ptr_slot+0 as ptr
    %out_len = load __bun_v_len_slot+0 as u64
[END_MACRO]

[MACRO] BUN_REVISION %out_ptr, %out_len, %out_status
    __bun_rev_ptr_slot = stack_alloc 8
    __bun_rev_len_slot = stack_alloc 8
    %out_status = call @sa_bun_plugin_revision(&__bun_rev_ptr_slot, &__bun_rev_len_slot)
    %out_ptr = load __bun_rev_ptr_slot+0 as ptr
    %out_len = load __bun_rev_len_slot+0 as u64
[END_MACRO]

